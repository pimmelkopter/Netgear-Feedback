[Service]
Type=simple
WorkingDirectory=/home/pi/Netgear-Feedback

Environment="OPENSSL_CONF=/home/pi/Netgear-Feedback/settings/openssl.cnf"
ExecStart=/home/pi/Netgear-Feedback/venv/bin/python3 -m src.main
Restart=on-failure
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target