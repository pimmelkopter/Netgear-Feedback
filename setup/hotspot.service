[Unit]
Description=WiFi Hotspot Service
After=network.target
Requires=NetworkManager.service

[Service]
Type=simple
WorkingDirectory=/home/pi/Netgear-Feedback
Environment="PYTHONPATH=/home/pi/Netgear-Feedback"
ExecStart=/home/pi/Netgear-Feedback/venv/bin/python3 -m hotspot.hotspot
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target